# GitHub token for the contribution bar (optional: without it the site uses a public mirror).
# Create one at https://github.com/settings/tokens: a fine-grained token with "Public repositories" and no extra permissions.
GITHUB_TOKEN=

# Connect 4 live games (Supabase → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Random string that signs John's Join links and owner cookie: openssl rand -base64 32
C4_OWNER_SECRET=
