# GitHub token for the contribution bar (optional: without it the site uses a public mirror).
# Create one at https://github.com/settings/tokens: a fine-grained token with "Public repositories" and no extra permissions.
GITHUB_TOKEN=

# Connect 4 live games (Supabase → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Random string that signs John's Join links and owner cookie: openssl rand -base64 32
C4_OWNER_SECRET=

# Connect 4 phase 3
# Telegram: create a bot with @BotFather, then message it once and run the chat-id step from the README/chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Cloudflare Turnstile (dash.cloudflare.com → Turnstile). For local testing Cloudflare's always-pass keys work:
#   site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
